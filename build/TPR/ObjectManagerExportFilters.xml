<?xml version="1.0" encoding="UTF-8"?>
<!-- ObjectManager export filters for Third-Party Remediation Tracker (TPR). Place next to ObjectManager.sh -->
<!-- objectProfiles/responsiveViews wrappers are from the 9.2.x docs examples; contentTypes/bundleTypes/queryDefinitions
     follow the same loader convention - confirm against ObjectManagerExportFilters-Example.xml in your tools client bin/. -->
<openpagesConfigurationBOM xmlFormatVersion="1.0">
  <contentTypes>
    <contentType name="TPRRemediation"/>
    <contentType name="TPRMilestone"/>
  </contentTypes>
  <bundleTypes>
    <bundleType name="TPR-Rem"/>
    <bundleType name="TPR-Ms"/>
  </bundleTypes>
  <objectProfiles>
    <objectProfile name="OpenPages Modules Master"/>
  </objectProfiles>
  <responsiveViews>
    <responsiveView name="TPRRemediation-Task"/>
    <responsiveView name="TPRRemediation-Grid"/>
    <responsiveView name="TPRRemediation-Create"/>
  </responsiveViews>
  <queryDefinitions>
    <queryDefinition name="TPR Open Remediations"/>
    <queryDefinition name="TPR Vendor Findings"/>
  </queryDefinitions>
</openpagesConfigurationBOM>