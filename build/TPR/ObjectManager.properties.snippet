# Merge into openpages-tools-client/bin/ObjectManager.properties (back it up first).
# Only these categories are dumped; the filters file narrows them to the solution's items.
configuration.manager.dump.jsp.based.content.types=true
configuration.manager.dump.bundle.types=true
configuration.manager.dump.content.type.relationship.sets=true
configuration.manager.dump.object.profiles=true
configuration.manager.dump.admin.objectprofile.views=true
configuration.manager.dump.responsive.views=true
configuration.manager.dump.query.definitions=true
configuration.manager.dump.process.definitions=true
# NOTE: relationship sets and workflow (process) definitions have no documented predefined filter
# element: review the dump and remove unrelated entries, or export workflows via Configuration Packaging.
